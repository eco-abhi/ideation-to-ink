# LLM (routed through LiteLLM -- provider-agnostic; use any litellm-supported model string)
# https://docs.litellm.ai/docs/providers
DEFAULT_LLM_MODEL=anthropic/claude-sonnet-5
ANTHROPIC_API_KEY=

# Optional: override the model per agent, e.g. a cheaper model for high-volume nodes.
# Format: JSON object of agent_name -> litellm model string.
# AGENT_MODEL_OVERRIDES={"literature_scout": "anthropic/claude-haiku-4-5"}

# novelty_checker embeds claims vs. corpus abstracts. Pick an embedding-capable model --
# it does not have to match DEFAULT_LLM_MODEL (e.g. pair a Claude chat model with an
# OpenAI or Voyage embedding model).
EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_API_KEY=

# Semantic Scholar works without a key but is heavily rate-limited; request one at
# https://www.semanticscholar.org/product/api for reliable literature_scout runs.
SEMANTIC_SCHOLAR_API_KEY=

# CrossRef asks for a contact email in the User-Agent as a courtesy ("polite pool"),
# not an API key -- higher, more reliable rate limits result.
CROSSREF_CONTACT_EMAIL=

# On-disk cache TTL (days) for literature API responses.
LITERATURE_CACHE_TTL_DAYS=30
